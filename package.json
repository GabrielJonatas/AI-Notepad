{
  "name": "mindpad",
  "version": "1.0.0",
  "description": "\"MindPad is a simple note-taking app with optional AI guidance, built with Node.js, Express, and React.\"",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env dist/server.js",
    "build": "esbuild src/server.ts --bundle --minify --platform=node --format=esm --outfile=dist/server.js --external:express",
    "dev": "tsx --env-file=.env src/server.ts",
    "devdb": "npx prisma db push && npx prisma generate"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "author": "Gabriel J",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "prisma": "^6.14.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
